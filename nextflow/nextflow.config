// splicescope Nextflow configuration

manifest {
    name            = 'splicescope'
    author          = 'Elmasnur Yılmaz'
    description     = 'Detect and characterize cryptic splicing from splice junctions'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version         = '0.1.0'
}

// Sensible default resources; scale per process as data grows.
process {
    cpus   = 2
    memory = '4 GB'
    time   = '1h'
}

profiles {
    // Quick, self-contained run on simulated data (used by CI and demos).
    test {
        params.genes      = 8
        params.replicates = 5
        process.cpus      = 1
    }

    // Reproducible execution inside a container.
    docker {
        docker.enabled = true
        process.container = 'python:3.11-slim'
    }

    conda {
        conda.enabled = true
        process.conda = 'python=3.11 pip'
    }
}

// Provenance: an execution report + timeline for every run.
report   { enabled = true; file = "${params.outdir}/pipeline_report.html"; overwrite = true }
timeline { enabled = true; file = "${params.outdir}/pipeline_timeline.html"; overwrite = true }
